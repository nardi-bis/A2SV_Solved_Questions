class Solution:
    def findRotation(self, mat: List[List[int]], target: List[List[int]]) -> bool:
        row=len(mat)
        col=len(mat[0])
        
        for k in range(4):
            if mat==target:
                return True
        
            res=[]
            for j in range(col):
                r=[]
                for i in range(row-1,-1,-1):
                    r.append(mat[i][j])
                res.append(r)
            
            mat=res
        
        return False
           


