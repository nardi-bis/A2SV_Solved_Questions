n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))

i=0
j=0
count=0

while i<n and j<m:
    if a[i]<b[j]:
        i+=1
    elif a[i]>b[j]:
        j+=1
    else:
        counta=0
        countb=0
        k=a[i]
        while i<n and a[i]==k:
            counta+=1
            i+=1
        kb=b[j]
        while j<m and b[j]==kb:
            countb+=1
            j+=1
        count+=counta*countb
print(count)
