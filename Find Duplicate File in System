class Solution:
    def findDuplicate(self, paths: List[str]) -> List[List[str]]:
        table=defaultdict(list)
        for i in range(len(paths)):
            ps = paths[i].split(" ")
            directory = ps[0]
            for j in range(1,len(ps)):
                name,content = ps[j].split("(")
                content=content[:-1]
                full=directory+'/'+name
                table[content].append(full)
        res=[]
        for v in table.values():
            if len(v)>1:
                res.append(v)
        return res


      
        
