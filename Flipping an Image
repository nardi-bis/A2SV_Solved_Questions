class Solution:
    def flipAndInvertImage(self, image: List[List[int]]) -> List[List[int]]:
        res=[]
        for i in range(len(image)):
            r=[]
            for j in range(len(image[0])):
                r.append(image[i][j])
            res.append(list(reversed(r)))
        for num in res:
            for i in range(len(num)):
                if num[i]==0:
                    num[i]=1
                else:
                    num[i]=0
        return res

            
