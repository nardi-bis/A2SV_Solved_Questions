class Solution:
    def isHappy(self, n: int) -> bool:
        v=set()
        
        while n!=1:
            if n in v:
                return False
            else:
                v.add(n)
                sums=0
                while n>0:
                    d=n%10
                    sums+=d*d
                    n=n//10
                n=sums
        return True

        
