class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if not nums:
            return 0
        count=1
        longest=1
        y=sorted(set(nums))
        for i in range(len(y)-1):
            if y[i]+1==y[i+1]:
                count+=1
                longest=max(longest,count)
            else:
                count=1
        return longest









































        
        
            
